# Browser-safe environment only (NEXT_PUBLIC_* prefix)
# Copy to .env.local and fill in values after running supabase start.

NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-from-supabase-status

# Base URL of the VicTenancy API (NestJS). Must match an entry in the API's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
