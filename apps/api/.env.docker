# Docker Compose environment (committed, placeholder values only)
# For real local development, copy apps/api/.env.example to apps/api/.env
# and fill SUPABASE_PUBLISHABLE_KEY from `supabase status`.

DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
QDRANT_URL=http://qdrant:6333
NODE_ENV=development
LOG_LEVEL=debug

# Supabase Auth — use real anon key in your .env for auth features
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-anon-key-from-supabase-status
