generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum AuthorRole {
  user
  assistant

  @@map("author_role")
}

enum JobStatus {
  queued
  processing
  succeeded
  failed
  cancelled

  @@map("job_status")
}

model User {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  conversations       Conversation[]
  agentJobs           AgentJob[]
  quotaCounters       RequestQuotaCounter[]

  @@map("users")
}

model Conversation {
  id             String   @id @default(uuid()) @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  title          String   @default("New conversation")
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz()
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  creationIdempotencyKey String? @map("creation_idempotency_key")

  owner    User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  messages Message[]
  jobs     AgentJob[]

  @@index([ownerUserId, lastActivityAt(sort: Desc), id(sort: Desc)], map: "idx_conversations_owner_activity")
  @@unique([ownerUserId, creationIdempotencyKey], map: "uq_conversations_creation_idempotency")
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorRole     AuthorRole @map("author_role")
  content        String   @db.Text
  metadata       Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  citations    Citation[]
  triggerJobs  AgentJob[]  @relation("TriggerMessage")
  assistantJob AgentJob?   @relation("AssistantMessage")

  @@index([conversationId, createdAt], map: "idx_messages_conversation_time")
  @@map("messages")
}

model AgentJob {
  id                 String    @id @default(uuid()) @db.Uuid
  conversationId     String    @map("conversation_id") @db.Uuid
  triggerMessageId   String    @map("trigger_message_id") @db.Uuid
  ownerUserId        String    @map("owner_user_id") @db.Uuid
  status             JobStatus @default(queued)
  idempotencyKey     String    @map("idempotency_key")
  correlationId      String    @default(uuid()) @map("correlation_id") @db.Uuid
  attempt            Int       @default(0)
  maxAttempts        Int       @default(3) @map("max_attempts")
  leaseToken         String?   @map("lease_token") @db.Uuid
  leaseUntil         DateTime? @map("lease_until") @db.Timestamptz()
  deliveryId         String?   @map("delivery_id") @db.Uuid
  nextAttemptAt      DateTime? @map("next_attempt_at") @db.Timestamptz()
  completedAt        DateTime? @map("completed_at") @db.Timestamptz()
  errorMetadata      Json?     @map("error_metadata") @db.JsonB
  assistantMessageId String?   @unique @map("assistant_message_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  triggerMessage  Message      @relation("TriggerMessage", fields: [triggerMessageId], references: [id], onDelete: Restrict)
  assistantMessage Message?    @relation("AssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)
  owner           User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  outbox          AgentJobOutbox?

  @@unique([ownerUserId, idempotencyKey], map: "uq_idempotency_per_owner")
  @@index([conversationId, createdAt], map: "idx_agent_jobs_conversation")
  @@map("agent_jobs")
}

model AgentJobOutbox {
  id                  String    @id @default(uuid()) @db.Uuid
  agentJobId          String    @unique @map("agent_job_id") @db.Uuid
  availableAt         DateTime  @default(now()) @map("available_at") @db.Timestamptz()
  publishedAt         DateTime? @map("published_at") @db.Timestamptz()
  dispatchLeaseToken  String?   @map("dispatch_lease_token") @db.Uuid
  dispatchLeaseUntil  DateTime? @map("dispatch_lease_until") @db.Timestamptz()
  deliveryId          String?   @map("delivery_id") @db.Uuid
  dispatchCount       Int       @default(0) @map("dispatch_count")
  lastError           Json?     @map("last_error") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  agentJob AgentJob @relation(fields: [agentJobId], references: [id], onDelete: Cascade)

  @@map("agent_job_outbox")
}

model Citation {
  id               String   @id @default(uuid()) @db.Uuid
  messageId        String   @map("message_id") @db.Uuid
  label            String
  jurisdiction     String   @default("VIC")
  instrumentType   String   @default("rta") @map("instrument_type")
  instrumentTitle  String   @default("") @map("instrument_title")
  instrumentVersion String  @default("") @map("instrument_version")
  sectionReference String   @default("") @map("section_reference")
  sourceChunkId    String?  @map("source_chunk_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "idx_citations_message")
  @@map("citations")
}

model RequestQuotaCounter {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  windowKind   String    @map("window_kind") @db.VarChar(10)
  windowStart  DateTime  @map("window_start") @db.Timestamptz()
  count        Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, windowKind, windowStart])
  @@map("request_quota_counters")
}
