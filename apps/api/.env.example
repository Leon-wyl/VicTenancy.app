# Server-side environment (never exposed to browser)
# Copy to .env and fill in values for local development.

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
QDRANT_URL=http://qdrant:6333
NODE_ENV=development
LOG_LEVEL=debug
REQUESTS_PER_MINUTE=20
REQUESTS_PER_DAY=200

# CORS: comma-separated browser origins allowed to call the API (no paths, no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Supabase Auth
# Run `supabase status` to get the real anon key; copy it into your .env (never commit).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_ANON_KEY_FROM_SUPABASE_STATUS

# Optional: override default JWT validation values
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# Agent Runtime (local development only)
# Set to "local" for development with a locally running Agent Runtime.
# Set to "aws_iam" only in deployed AWS environments.
AGENT_RUNTIME_MODE=local
AGENT_RUNTIME_INVOKE_URL=http://localhost:8080
